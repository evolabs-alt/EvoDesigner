<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TaggJack.UI.LicenseActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaggJack - License Activation"
        Height="520" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#007ACC" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#005A9E" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Background" Value="#CCCCCC" />
            <Setter Property="Cursor" Value="Arrow" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#6C757D" />
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#5A6268" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="License Activation" FontSize="22" FontWeight="Bold" Foreground="#007ACC" />
      <TextBlock Text="Request activation from Evolabs admin.evolabs.co (product TAGGJACK)"
                 FontSize="12" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,0" />
    </StackPanel>

    <Border x:Name="StatusPanel" Grid.Row="1" Background="#FFF3CD" BorderBrush="#FFC107" BorderThickness="1"
            CornerRadius="3" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
      <TextBlock x:Name="StatusText" FontWeight="SemiBold" Foreground="#856404" TextWrapping="Wrap" />
    </Border>

    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3"
            Padding="12" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="Hardware key" FontWeight="SemiBold" Margin="0,0,0,6" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Content="Copy" Click="CopyKey_Click" Margin="8,0,0,0" Padding="12,6" />
          <TextBox x:Name="HardwareKeyTextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                   TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="52" />
        </DockPanel>
        <TextBlock Text="Send this key to Evolabs if asked. It is bound to this PC."
                   FontSize="11" Foreground="#999999" Margin="0,6,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="3" Margin="0,0,0,12">
      <TextBlock Text="Customer details (optional)" FontWeight="SemiBold" Margin="0,0,0,8" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="10" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Company / name" Margin="0,0,0,4" />
          <TextBox x:Name="CustomerHintTextBox" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Contact email" Margin="0,0,0,4" />
          <TextBox x:Name="ContactTextBox" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <TextBlock x:Name="InfoText" Grid.Row="4" FontSize="12" Foreground="#555555" TextWrapping="Wrap"
               VerticalAlignment="Top" />

    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Button x:Name="RequestButton" Grid.Column="1" Content="Request activation" Click="Request_Click" />
      <Button x:Name="CheckButton" Grid.Column="3" Content="Check license" Click="Check_Click" />
      <Button Grid.Column="5" Content="Exit" Style="{StaticResource SecondaryButton}" Click="ExitButton_Click" />
    </Grid>
  </Grid>
</Window>
