<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TaggJack.UI.InkjetProtocolLogWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Protocol Log" Height="520" Width="860" WindowStartupLocation="CenterOwner" xmlns:ui="clr-namespace:TaggJack.UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#f3f2f1" BorderBrush="#d1d2d3" BorderThickness="0,0,0,1" Padding="16,12">
      <DockPanel>
        <TextBlock x:Name="HeaderText" Text="Protocol Log" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Copy" Width="80" Height="28" Margin="0,0,8,0" Click="Copy_Click" />
          <Button Content="Clear" Width="80" Height="28" Click="Clear_Click" />
        </StackPanel>
      </DockPanel>
    </Border>
    <TextBox x:Name="LogTextBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="12" BorderBrush="#d1d2d3" />
    <Border Grid.Row="2" Background="#f3f2f1" BorderBrush="#d1d2d3" BorderThickness="0,1,0,0" Padding="16,10">
      <Button Content="Close" Width="80" Height="28" HorizontalAlignment="Right" Click="Close_Click" />
    </Border>
  </Grid>
</Window>