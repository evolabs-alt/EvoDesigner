<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TaggJack.UI.SplashScreen" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TaggJack" Height="400" Width="600" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" AllowsTransparency="True" Background="#00FFFFFF" Topmost="True" xmlns:ui="clr-namespace:TaggJack.UI">
  <Border Background="#FFFFFFFF" BorderBrush="#2196F3" BorderThickness="2" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="60" />
      </Grid.RowDefinitions>
      <Viewbox Grid.Row="0" Margin="60">
        <Image x:Name="LogoImage" Source="/Logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
      </Viewbox>
      <TextBlock Grid.Row="1" Text="TaggJack" FontSize="32" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center" Margin="0,10,0,10" />
      <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar x:Name="LoadingProgressBar" Width="300" Height="6" IsIndeterminate="True" Foreground="#2196F3" Background="#E0E0E0" Margin="0,10,0,10" />
        <TextBlock x:Name="StatusText" Text="Loading..." FontSize="14" Foreground="#666666" HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Border>
</Window>