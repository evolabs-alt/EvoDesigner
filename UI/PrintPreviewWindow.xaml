<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TaggJack.UI.PrintPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Print Preview" Height="600" Width="900" WindowStartupLocation="CenterOwner" xmlns:ui="clr-namespace:TaggJack.UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="20,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" Text="Print Preview" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5" />
      <TextBlock x:Name="LabelSizeInfo" Grid.Row="1" Text="Label Size: 70mm × 30mm" FontSize="12" Foreground="#666666" HorizontalAlignment="Center" Margin="0,0,0,5" />
      <StackPanel x:Name="NavigationPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
        <Button x:Name="PrevButton" Content="◀ Previous" Width="80" Height="25" Margin="0,0,10,0" Click="PrevRecord_Click" />
        <TextBlock x:Name="RecordCounter" Text="Record 1 of 1" FontSize="12" VerticalAlignment="Center" Margin="10,0" />
        <Button x:Name="NextButton" Content="Next ▶" Width="80" Height="25" Margin="10,0,0,0" Click="NextRecord_Click" />
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" Margin="20" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FFFFFFFF">
      <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border BorderBrush="#333" BorderThickness="2" CornerRadius="4" Background="#FFFFFFFF" Padding="20">
          <Border BorderBrush="#666" BorderThickness="1" Background="#FFFFFFFF">
            <UIElement.Effect>
              <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="3" Opacity="0.3" />
            </UIElement.Effect>
            <Canvas x:Name="PreviewCanvas" Background="#FFFFFFFF" ClipToBounds="True" />
          </Border>
        </Border>
      </Grid>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="20,10">
      <Button Content="Print" Width="80" Height="30" Margin="0,0,10,0" Click="Print_Click" />
      <Button Content="Close" Width="80" Height="30" Click="Close_Click" />
    </StackPanel>
  </Grid>
</Window>