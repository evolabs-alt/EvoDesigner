<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TaggJack.UI.ItemMasterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TaggJack - Item Master" Height="600" Width="1000" WindowStartupLocation="CenterScreen" xmlns:ui="clr-namespace:TaggJack.UI">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="ModernDataGridStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#d1d2d3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="DataGrid.GridLinesVisibility" Value="Horizontal" />
        <Setter Property="DataGrid.AutoGenerateColumns" Value="False" />
        <Setter Property="DataGrid.IsReadOnly" Value="True" />
        <Setter Property="DataGrid.SelectionMode" Value="Single" />
        <Setter Property="DataGrid.AlternatingRowBackground" Value="#faf9f8" />
        <Setter Property="DataGrid.RowHeight" Value="32" />
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Background="#f3f2f1" BorderBrush="#d1d2d3" BorderThickness="0,0,0,1" Padding="20,16">
      <TextBlock Text="Item Master" FontSize="20" FontWeight="SemiBold" />
    </Border>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,12,20,8">
      <TextBox x:Name="SearchBox" Width="260" Height="30" Margin="0,0,8,0" />
      <Button Content="Search" Width="80" Height="30" Margin="0,0,8,0" Click="Search_Click" />
      <Button Content="Clear" Width="80" Height="30" Margin="0,0,20,0" Click="Clear_Click" />
      <Button Content="Add" Width="80" Height="30" Margin="0,0,8,0" Click="Add_Click" />
      <Button Content="Edit" Width="80" Height="30" Margin="0,0,8,0" Click="Edit_Click" />
      <Button Content="Delete" Width="80" Height="30" Margin="0,0,8,0" Click="Delete_Click" />
      <Button Content="Export CSV" Width="100" Height="30" Click="Export_Click" />
    </StackPanel>
    <DataGrid x:Name="ItemsGrid" Grid.Row="2" Margin="20,0,20,12" Style="{StaticResource ModernDataGridStyle}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Item Code" Width="120" Binding="{Binding ItemCode}" />
        <DataGridTextColumn Header="GTIN" Width="150" Binding="{Binding Gtin}" />
        <DataGridTextColumn Header="Description" Width="*" MinWidth="180" Binding="{Binding Description}" />
        <DataGridTextColumn Header="Level 1" Width="80" Binding="{Binding Level1}" />
        <DataGridTextColumn Header="Level 2" Width="80" Binding="{Binding Level2}" />
        <DataGridTextColumn Header="Level 3" Width="80" Binding="{Binding Level3}" />
        <DataGridTextColumn Header="Updated" Width="160" Binding="{Binding UpdatedAt}" />
      </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="3" Background="#f3f2f1" BorderBrush="#d1d2d3" BorderThickness="0,1,0,0" Padding="20,12">
      <Button Content="Close" HorizontalAlignment="Right" Width="80" Height="32" Click="Close_Click" />
    </Border>
  </Grid>
</Window>