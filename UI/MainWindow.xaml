<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TaggJack.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:local="clr-namespace:TaggJack" xmlns:ui="clr-namespace:TaggJack.UI" xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF" Title="TaggJack - Professional Label Designer" Height="800" Width="1400" WindowState="Maximized" Background="#f5f5f5" Focusable="True" KeyboardNavigation.TabNavigation="Local" Loaded="MainWindow_Loaded" Closing="MainWindow_Closing">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="ModernButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#f8f9fa" />
        <Setter Property="Foreground" Value="#323130" />
        <Setter Property="BorderBrush" Value="#d1d2d3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#0078d4" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                  <Setter Property="BorderBrush" Value="#106ebe" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Background" Value="#005a9e" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ToolboxButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Height" Value="26" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,4" />
      </Style>
      <Style x:Key="CompactButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,4" />
      </Style>
      <Style x:Key="MenuItemStyle" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="#323130" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="5,5,5,0" />
      </Style>
      <Style x:Key="ModernTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="Foreground" Value="#323130" />
        <Setter Property="BorderBrush" Value="#d1d2d3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="3">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsFocused" Value="True">
                  <Setter Property="BorderBrush" Value="#0078d4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ModernCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="#323130" />
        <Setter Property="FontSize" Value="11" />
      </Style>
      <Style x:Key="ModernLabelStyle" TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="#323130" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="0,2" />
      </Style>
      <Style x:Key="ModernComboBoxStyle" TargetType="{x:Type ComboBox}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#d1d2d3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#323130" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,2,28,2" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="2">
                <Grid>
                  <ToggleButton x:Name="ToggleButton" Background="#00FFFFFF" BorderThickness="0" Focusable="false" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="20" />
                      </Grid.ColumnDefinitions>
                      <Path x:Name="Arrow" Grid.Column="1" Fill="#605e5c" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" Data="M0,0 L4,4 L8,0" />
                    </Grid>
                  </ToggleButton>
                  <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" Margin="8,6,28,6" VerticalAlignment="Center" HorizontalAlignment="Left" />
                  <TextBox x:Name="PART_EditableTextBox" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,6,28,6" Focusable="True" Background="#00FFFFFF" Visibility="Hidden" IsReadOnly="{TemplateBinding ComboBox.IsReadOnly}" Style="{x:Null}" />
                  <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding FrameworkElement.ActualWidth}" MaxHeight="{TemplateBinding ComboBox.MaxDropDownHeight}">
                      <Border x:Name="DropDownBorder" Background="#FFFFFFFF" BorderThickness="1" BorderBrush="#d1d2d3" />
                      <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                      </ScrollViewer>
                    </Grid>
                  </Popup>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="BorderBrush" Value="#0078d4" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter Property="BorderBrush" Value="#0078d4" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SectionHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#0078d4" />
        <Setter Property="Margin" Value="0,0,0,8" />
      </Style>
      <Style x:Key="SubHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="#605e5c" />
        <Setter Property="Margin" Value="0,8,0,4" />
      </Style>
      <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ffffff" Offset="0" />
        <GradientStop Color="#f8f9fa" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="ToolboxGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#faf9f8" Offset="0" />
        <GradientStop Color="#f3f2f1" Offset="1" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top" Background="#FFFFFFFF" BorderThickness="0">
      <MenuItem Header="_File" Style="{StaticResource MenuItemStyle}">
        <MenuItem x:Name="NewMenuItem" Header="_New Template" Click="New_Click">
          <MenuItem.Icon>
            <TextBlock Text="🆕" FontSize="14" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator Background="#d1d2d3" />
        <MenuItem x:Name="LoadTemplateMenuItem" Header="_Load Template..." Click="LoadTemplate_Click">
          <MenuItem.Icon>
            <TextBlock Text="📁" FontSize="14" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="SaveTemplateMenuItem" Header="_Save Template" Click="SaveTemplate_Click">
          <MenuItem.Icon>
            <TextBlock Text="💾" FontSize="14" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="SaveAsTemplateMenuItem" Header="Save Template _As..." Click="SaveAsTemplate_Click">
          <MenuItem.Icon>
            <TextBlock Text="💾" FontSize="14" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator Background="#d1d2d3" />
        <MenuItem x:Name="PrintPreviewMenuItem" Header="_Print..." Click="PrintPreview_Click">
          <MenuItem.Icon>
            <TextBlock Text="🖨️" FontSize="14" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator Background="#d1d2d3" />
        <MenuItem x:Name="TemplateTypeMenu" Header="Template Type">
          <MenuItem x:Name="TemplateTypeStandardMenuItem" Header="Standard" IsCheckable="True" IsChecked="True" Click="TemplateTypeStandard_Click" />
          <MenuItem x:Name="TemplateTypeMarkemMenuItem" Header="Markem-Imaje" IsCheckable="True" Click="TemplateTypeMarkem_Click" />
          <MenuItem x:Name="TemplateTypeLinxMenuItem" Header="Linx" IsCheckable="True" Click="TemplateTypeLinx_Click" />
        </MenuItem>
        <Separator Background="#d1d2d3" />
        <MenuItem x:Name="ExitMenuItem" Header="E_xit" Click="Exit_Click">
          <MenuItem.Icon>
            <TextBlock Text="🚪" FontSize="14" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem x:Name="MarkemMenu" Header="_Markem-Imaje" Style="{StaticResource MenuItemStyle}" Visibility="Collapsed">
        <MenuItem Header="Show Protocol Log..." Click="InkjetShowProtocolLog_Click" />
        <Separator />
        <MenuItem Header="Ping" Click="InkjetPing_Click" />
        <MenuItem Header="Select Job" Click="InkjetSelect_Click" />
        <MenuItem Header="List Jobs" Click="InkjetList_Click" />
        <MenuItem Header="Send Vars (mapped sample)..." Click="InkjetVars_Click" />
        <MenuItem Header="Dump Job" Click="InkjetDump_Click" />
        <MenuItem Header="Make External" Click="InkjetMakeExternal_Click" />
        <Separator />
        <MenuItem Header="Queue Enable" Click="InkjetQueueEnable_Click" />
        <MenuItem Header="Queue Disable" Click="InkjetQueueDisable_Click" />
        <MenuItem Header="Queue Reset" Click="InkjetQueueReset_Click" />
        <MenuItem Header="Queue Status" Click="InkjetQueueStatus_Click" />
        <Separator />
        <MenuItem Header="Jet Start" Click="InkjetJetStart_Click" />
        <MenuItem Header="Jet Stop" Click="InkjetJetStop_Click" />
        <MenuItem Header="Trigger Print" Click="InkjetTrigger_Click" />
        <MenuItem Header="Ack Faults" Click="InkjetAckFaults_Click" />
        <Separator />
        <MenuItem Header="Push Library (Force)..." Click="InkjetPushLibrary_Click" />
      </MenuItem>
      <MenuItem x:Name="LinxMenu" Header="_Linx" Style="{StaticResource MenuItemStyle}" Visibility="Collapsed">
        <MenuItem Header="Show Protocol Log..." Click="InkjetShowProtocolLog_Click" />
        <Separator />
        <MenuItem Header="Status" Click="LinxStatus_Click" />
        <MenuItem Header="Select Message" Click="LinxSelect_Click" />
        <MenuItem Header="List Messages" Click="LinxList_Click" />
        <MenuItem Header="Remote Fields" Click="LinxRemoteFields_Click" />
        <Separator />
        <MenuItem Header="Queue Clear" Click="LinxQueueClear_Click" />
        <MenuItem Header="Queue Mode" Click="LinxQueueMode_Click" />
        <Separator />
        <MenuItem Header="Jet Start" Click="LinxJetStart_Click" />
        <MenuItem Header="Jet Stop" Click="LinxJetStop_Click" />
        <MenuItem Header="Start Print" Click="LinxStartPrint_Click" />
        <MenuItem Header="Stop Print" Click="LinxStopPrint_Click" />
        <MenuItem Header="Trigger Print" Click="LinxTrigger_Click" />
      </MenuItem>
      <MenuItem Header="_View" Style="{StaticResource MenuItemStyle}">
        <MenuItem x:Name="ViewGridMenuItem" Header="Show Grid" IsCheckable="True" IsChecked="True" Click="ShowGrid_Click">
          <MenuItem.Icon>
            <TextBlock Text="📏" FontSize="14" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Data" Style="{StaticResource MenuItemStyle}">
        <MenuItem x:Name="SetupDataSourceMenuItem" Header="Setup _Data Source..." Click="DataSource_Click">
          <MenuItem.Icon>
            <TextBlock Text="🔌" FontSize="14" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="MapFieldsMenuItem" Header="Setup _Map Fields..." Click="MapFields_Click">
          <MenuItem.Icon>
            <TextBlock Text="🗺️" FontSize="14" />
          </MenuItem.Icon>
        </MenuItem>
        <Separator />
        <MenuItem x:Name="SampleDataMenuItem" Header="_Sample Data..." Click="SampleData_Click">
          <MenuItem.Icon>
            <TextBlock Text="📊" FontSize="14" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="Gs1SampleDataMenuItem" Header="GS1 Sample Data..." Visibility="Collapsed" Click="Gs1SampleData_Click">
          <MenuItem.Icon>
            <TextBlock Text="🏷️" FontSize="14" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
      <MenuItem x:Name="ElementsMenu" Header="_Elements" Style="{StaticResource MenuItemStyle}">
        <MenuItem Header="Text" Tag="Text" Click="MenuElement_Click" />
        <MenuItem Header="Image" Tag="Image" Click="MenuElement_Click" />
        <MenuItem Header="Linked Image" Tag="LinkedImage" Click="MenuElement_Click" />
        <Separator Background="#d1d2d3" />
        <MenuItem Header="Line" Tag="Line" Click="MenuElement_Click" />
        <MenuItem Header="Rectangle" Tag="Rectangle" Click="MenuElement_Click" />
        <MenuItem Header="Ellipse" Tag="Ellipse" Click="MenuElement_Click" />
        <Separator Background="#d1d2d3" />
        <MenuItem Header="EAN-13" Tag="EAN13" Click="MenuElement_Click" />
        <MenuItem Header="EAN-8" Tag="EAN8" Click="MenuElement_Click" />
        <MenuItem Header="UPC-A" Tag="UPC-A" Click="MenuElement_Click" />
        <MenuItem Header="UPC-E" Tag="UPC-E" Click="MenuElement_Click" />
        <MenuItem Header="Code 128" Tag="Code128" Click="MenuElement_Click" />
        <MenuItem Header="Code 39" Tag="Code39" Click="MenuElement_Click" />
        <MenuItem Header="DataMatrix" Tag="DataMatrix" Click="MenuElement_Click" />
        <MenuItem Header="PDF417" Tag="PDF417" Click="MenuElement_Click" />
        <MenuItem Header="Aztec" Tag="Aztec" Click="MenuElement_Click" />
        <MenuItem Header="GS1 DataBar" Tag="GS1DataBar" Click="MenuElement_Click" />
        <MenuItem Header="QR Code" Tag="QRCode" Click="MenuElement_Click" />
      </MenuItem>
      <MenuItem x:Name="Gs1Menu" Header="_GS1" Style="{StaticResource MenuItemStyle}" Visibility="Collapsed">
        <MenuItem x:Name="ItemMasterMenuItem" Header="Item Master..." Click="ItemMaster_Click" />
        <MenuItem x:Name="ErpImportMenuItem" Header="Import from ERP..." Visibility="Collapsed" Click="ErpImport_Click" />
        <Separator />
        <MenuItem x:Name="GenerateGs1MenuItem" Header="Generate GS1 Labels..." Click="GenerateGs1_Click" />
        <MenuItem x:Name="Gs1HistoryMenuItem" Header="Serial History..." Click="Gs1History_Click" />
        <MenuItem x:Name="Gs1SettingsMenuItem" Header="GS1 Settings..." Click="Gs1Settings_Click" />
      </MenuItem>
      <MenuItem Header="_About" Style="{StaticResource MenuItemStyle}">
        <MenuItem x:Name="RefreshLicenseMenuItem" Header="_Refresh License" Click="RefreshLicense_Click">
          <MenuItem.Icon>
            <TextBlock Text="🔄" FontSize="14" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem x:Name="AboutMenuItem" Header="_About TaggJack..." Click="About_Click">
          <MenuItem.Icon>
            <TextBlock Text="ℹ️" FontSize="14" />
          </MenuItem.Icon>
        </MenuItem>
      </MenuItem>
    </Menu>
    <Border x:Name="LicenseBanner" DockPanel.Dock="Top" Background="#FFF3CD" BorderBrush="#FFC107"
            BorderThickness="0,0,0,1" Padding="12,8" Visibility="Collapsed">
      <TextBlock x:Name="LicenseBannerText" FontSize="12" FontWeight="SemiBold" Foreground="#856404"
                 TextWrapping="Wrap" />
    </Border>
    <Grid Background="#f5f5f5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border x:Name="StandardToolbarBorder" Grid.ColumnSpan="3" Grid.Row="0" Background="{StaticResource PanelGradient}" BorderBrush="#d1d2d3" BorderThickness="0,0,0,1" Padding="16,12">
        <StackPanel Orientation="Horizontal">
          <Border Background="#f8f9fa" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal">
              <materialIcons:MaterialIcon Kind="Layers" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Layers" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" Foreground="#323130" FontSize="12" />
              <StackPanel x:Name="LayerControlsContainer" Orientation="Horizontal" />
            </StackPanel>
          </Border>
          <Border Background="#f8f9fa" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,16,0">
            <StackPanel Orientation="Horizontal">
              <materialIcons:MaterialIcon Kind="Magnify" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" Foreground="#323130" FontSize="12" />
              <Button x:Name="ZoomOutButton" Content="−" Width="36" Height="28" Margin="0,0,4,0" Style="{StaticResource ModernButtonStyle}" ToolTip="Zoom Out" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
              <Border Background="#FFFFFFFF" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="3" Width="60" Height="28" Margin="4,0">
                <TextBlock x:Name="ZoomTextBlock" Text="100%" VerticalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold" Foreground="#323130" />
              </Border>
              <Button x:Name="ZoomInButton" Content="+" Width="36" Height="28" Margin="4,0,8,0" Style="{StaticResource ModernButtonStyle}" ToolTip="Zoom In" FontSize="14" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
              <Button x:Name="ZoomFitButton" Content="⊞" Width="40" Height="28" Margin="0,0,4,0" Style="{StaticResource ModernButtonStyle}" ToolTip="Fit to Window" FontSize="12" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
              <Button x:Name="ZoomResetButton" Content="1:1" Width="40" Height="28" Style="{StaticResource ModernButtonStyle}" ToolTip="Reset Zoom" FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
            </StackPanel>
          </Border>
          <Border x:Name="AlignmentToolbar" Background="#f8f9fa" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="6" Padding="12,8">
            <StackPanel Orientation="Horizontal">
              <materialIcons:MaterialIcon Kind="FormatAlignJustify" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Align" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" Foreground="#323130" FontSize="12" />
              <Button x:Name="AlignLeftButton" Width="40" Height="28" Margin="0,0,2,0" Style="{StaticResource ModernButtonStyle}" ToolTip="Align Left" Click="AlignLeft_Click">
                <materialIcons:MaterialIcon Kind="FormatAlignLeft" Width="16" Height="16" />
              </Button>
              <Button x:Name="AlignCenterButton" Width="40" Height="28" Margin="0,0,2,0" Style="{StaticResource ModernButtonStyle}" ToolTip="Align Center" Click="AlignCenter_Click">
                <materialIcons:MaterialIcon Kind="FormatAlignCenter" Width="16" Height="16" />
              </Button>
              <Button x:Name="AlignRightButton" Width="40" Height="28" Margin="0,0,8,0" Style="{StaticResource ModernButtonStyle}" ToolTip="Align Right" Click="AlignRight_Click">
                <materialIcons:MaterialIcon Kind="FormatAlignRight" Width="16" Height="16" />
              </Button>
              <Button x:Name="AlignTopButton" Width="40" Height="28" Margin="0,0,2,0" Style="{StaticResource ModernButtonStyle}" ToolTip="Align Top" Click="AlignTop_Click">
                <materialIcons:MaterialIcon Kind="FormatAlignTop" Width="16" Height="16" />
              </Button>
              <Button x:Name="AlignMiddleButton" Width="40" Height="28" Margin="0,0,2,0" Style="{StaticResource ModernButtonStyle}" ToolTip="Align Middle" Click="AlignMiddle_Click">
                <materialIcons:MaterialIcon Kind="FormatAlignMiddle" Width="16" Height="16" />
              </Button>
              <Button x:Name="AlignBottomButton" Width="40" Height="28" Style="{StaticResource ModernButtonStyle}" ToolTip="Align Bottom" Click="AlignBottom_Click">
                <materialIcons:MaterialIcon Kind="FormatAlignBottom" Width="16" Height="16" />
              </Button>
            </StackPanel>
          </Border>
          <Border Background="#f8f9fa" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="16,0,0,0">
            <StackPanel Orientation="Horizontal">
              <materialIcons:MaterialIcon Kind="Database" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBlock Text="Data" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" Foreground="#323130" FontSize="12" />
              <Button x:Name="RefreshDataButton" Content="⟳ Refresh" Height="28" Style="{StaticResource CompactButtonStyle}" ToolTip="Refresh data from configured source" Click="RefreshData_Click" />
              <Border Background="#2D2D30" BorderBrush="#555555" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="8,0,0,0">
                <TextBlock x:Name="DataStatusTextBlock" Text="No data" VerticalAlignment="Center" FontStyle="Italic" Foreground="#9CDCFE" FontSize="10" />
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>
      <Border x:Name="ToolboxBorder" Grid.Column="0" Grid.Row="1" Background="{StaticResource ToolboxGradient}" BorderBrush="#d1d2d3" BorderThickness="0,0,1,0">
        <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="Toolbox" Style="{StaticResource SectionHeaderStyle}" FontSize="16" Margin="0,0,0,16" />
            <Button Content="Text" Style="{StaticResource ToolboxButtonStyle}" ToolTip="Add text element with customizable fonts and styles" />
            <Button Content="Image" Style="{StaticResource ToolboxButtonStyle}" ToolTip="Add image element (PNG, JPEG, BMP supported)" />
            <Button Content="Linked Image" Style="{StaticResource ToolboxButtonStyle}" ToolTip="Add linked image from URL (loads from web or database)" />
            <TextBlock Text="Drawing" Style="{StaticResource SectionHeaderStyle}" FontSize="12" Margin="0,16,0,8" />
            <Button Content="Line" Style="{StaticResource ToolboxButtonStyle}" ToolTip="Draw lines with customizable width and color" />
            <Button Content="Rectangle" Style="{StaticResource ToolboxButtonStyle}" ToolTip="Draw rectangles with customizable border width and color" />
            <Button Content="Ellipse" Style="{StaticResource ToolboxButtonStyle}" ToolTip="Draw ovals and circles with customizable border width and color" />
            <TextBlock Text="Barcodes" Style="{StaticResource SectionHeaderStyle}" FontSize="12" Margin="0,16,0,8" />
            <Button Content="EAN-13" Style="{StaticResource ToolboxButtonStyle}" ToolTip="European Article Number (13-digit) - Most common retail barcode" />
            <Button Content="EAN-8" Style="{StaticResource ToolboxButtonStyle}" ToolTip="European Article Number (8-digit) - Compact retail barcode" />
            <Button Content="UPC-A" Style="{StaticResource ToolboxButtonStyle}" ToolTip="Universal Product Code A - North American standard" />
            <Button Content="UPC-E" Style="{StaticResource ToolboxButtonStyle}" ToolTip="Universal Product Code E - Compact UPC format" />
            <Button Content="Code 128" Style="{StaticResource ToolboxButtonStyle}" ToolTip="High-density barcode for shipping and logistics" />
            <Button Content="Code 39" Style="{StaticResource ToolboxButtonStyle}" ToolTip="Alphanumeric barcode for inventory management" />
            <Button Content="DataMatrix" Style="{StaticResource ToolboxButtonStyle}" ToolTip="2D barcode for small items and electronics" />
            <Button Content="PDF417" Style="{StaticResource ToolboxButtonStyle}" ToolTip="2D barcode for documents and identification" />
            <Button Content="Aztec" Style="{StaticResource ToolboxButtonStyle}" ToolTip="2D barcode for transportation tickets" />
            <Button Content="GS1 DataBar" Style="{StaticResource ToolboxButtonStyle}" ToolTip="Next-generation GS1 barcode standard" />
            <Button Content="QR Code" Style="{StaticResource ToolboxButtonStyle}" ToolTip="QR code for URLs, contact info, and mobile integration" />
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid x:Name="RulerCanvasGrid" Grid.Column="1" Grid.Row="1" Background="#f5f5f5">
        <Grid.RowDefinitions>
          <RowDefinition Height="30" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Canvas x:Name="TopRuler" Grid.Column="1" Grid.Row="0" Background="#e1e2e4" ClipToBounds="True" Height="30" RenderTransformOrigin="0.5,0">
          <UIElement.RenderTransform>
            <ScaleTransform x:Name="TopRulerScaleTransform" ScaleX="1" ScaleY="1" />
          </UIElement.RenderTransform>
        </Canvas>
        <Canvas x:Name="LeftRuler" Grid.Column="0" Grid.Row="1" Background="#e1e2e4" ClipToBounds="True" Width="30" RenderTransformOrigin="0,0.5">
          <UIElement.RenderTransform>
            <ScaleTransform x:Name="LeftRulerScaleTransform" ScaleX="1" ScaleY="1" />
          </UIElement.RenderTransform>
        </Canvas>
        <Rectangle Grid.Column="0" Grid.Row="0" Fill="#d1d2d3" />
        <Canvas x:Name="GuideLineOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" IsHitTestVisible="False" ZIndex="1000" />
        <Border Grid.Column="1" Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#0078d4" BorderThickness="2" CornerRadius="6" Margin="4">
          <UIElement.Effect>
            <DropShadowEffect Color="Gray" BlurRadius="15" ShadowDepth="3" Opacity="0.2" />
          </UIElement.Effect>
          <ScrollViewer x:Name="CanvasScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="True" Background="#252526">
            <Grid x:Name="CanvasContainer" RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="CanvasContainer_MouseLeftButtonDown">
              <UIElement.RenderTransform>
                <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1" ScaleY="1" />
              </UIElement.RenderTransform>
              <Canvas x:Name="GridCanvas" Background="#FAFAFA" MouseLeftButtonDown="CanvasContainer_MouseLeftButtonDown">
                <UIElement.Effect>
                  <DropShadowEffect Color="#0078d4" BlurRadius="8" ShadowDepth="0" Opacity="0.2" />
                </UIElement.Effect>
              </Canvas>
              <Canvas x:Name="LabelCanvas" Background="#00FFFFFF" AllowDrop="True" ClipToBounds="False" Focusable="True" />
              <Canvas x:Name="MarginCanvas" Background="#00FFFFFF" IsHitTestVisible="False" />
            </Grid>
          </ScrollViewer>
        </Border>
      </Grid>
      <Border x:Name="PropertiesBorder" Grid.Column="2" Grid.Row="1" Background="{StaticResource PanelGradient}" BorderBrush="#d1d2d3" BorderThickness="1,0,0,0">
        <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="🏷️ Label Setup" Style="{StaticResource SectionHeaderStyle}" FontSize="16" />
            <TextBlock Text="Label Dimensions" Style="{StaticResource SubHeaderStyle}" />
            <Border Background="#f8f9fa" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <TextBlock Text="📐 Width:" Margin="0,0,8,0" Foreground="#605e5c" FontSize="11" />
                  <TextBlock x:Name="LabelWidthDisplay" Text="70.0 mm" FontWeight="SemiBold" Foreground="#323130" FontSize="11" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="📏 Height:" Margin="0,0,8,0" Foreground="#605e5c" FontSize="11" />
                  <TextBlock x:Name="LabelHeightDisplay" Text="30.0 mm" FontWeight="SemiBold" Foreground="#323130" FontSize="11" />
                </StackPanel>
              </StackPanel>
            </Border>
            <Button x:Name="ResizeButton" Content="📏 Resize Label" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,16" ToolTip="Change label dimensions and adjust elements" Click="ResizeButton_Click" />
            <TextBlock Text="🎨 Element Properties" Style="{StaticResource SectionHeaderStyle}" FontSize="16" />
            <Border Background="#f8f9fa" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="4" Padding="12" MinHeight="200">
              <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ElementPropertiesPanel">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                    <TextBlock Text="🎯" FontSize="24" Margin="0,0,8,0" />
                    <TextBlock Text="Select an element to view properties" Foreground="#605e5c" FontStyle="Italic" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border x:Name="InkjetHostBorder" Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="0" Grid.RowSpan="2" Background="#f5f5f5" Visibility="Collapsed">
        <ui:InkjetTemplatePanel x:Name="InkjetPanel" />
      </Border>
    </Grid>
  </DockPanel>
</Window>