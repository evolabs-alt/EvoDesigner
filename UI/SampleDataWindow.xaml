<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TaggJack.UI.SampleDataWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TaggJack - Sample Data Preview" Height="600" Width="1000" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" ShowInTaskbar="True" xmlns:ui="clr-namespace:TaggJack.UI">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="ModernDataGridStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#d1d2d3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="DataGrid.GridLinesVisibility" Value="All" />
        <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="#f3f2f1" />
        <Setter Property="DataGrid.VerticalGridLinesBrush" Value="#f3f2f1" />
        <Setter Property="DataGrid.AutoGenerateColumns" Value="True" />
        <Setter Property="DataGrid.IsReadOnly" Value="True" />
        <Setter Property="DataGrid.SelectionMode" Value="Single" />
        <Setter Property="DataGrid.HeadersVisibility" Value="Column" />
        <Setter Property="DataGrid.CanUserResizeRows" Value="False" />
        <Setter Property="DataGrid.CanUserAddRows" Value="False" />
        <Setter Property="DataGrid.AlternatingRowBackground" Value="#faf9f8" />
        <Setter Property="DataGrid.RowHeight" Value="32" />
      </Style>
      <Style x:Key="{x:Type DataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="#0078d4" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderBrush" Value="#005a9e" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
      </Style>
      <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
          <Trigger Property="DataGridCell.IsSelected" Value="True">
            <Setter Property="Background" Value="#e1f5fe" />
            <Setter Property="Foreground" Value="#323130" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#f3f2f1" BorderBrush="#d1d2d3" BorderThickness="0,0,0,1" Padding="20,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="Sample Data Preview" FontSize="20" FontWeight="SemiBold" Foreground="#323130" />
          <TextBlock x:Name="SubtitleText" Text="Showing up to 10 sample records from the data source" FontSize="12" Foreground="#605e5c" Margin="0,4,0,0" />
        </StackPanel>
        <Button x:Name="RefreshButton" Grid.Column="1" Content="↻ Refresh" Width="100" Height="32" Background="#0078d4" Foreground="#FFFFFFFF" BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Click="RefreshButton_Click">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Button}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Control.Background}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#106ebe" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Background" Value="#005a9e" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#FFFFFFFF" Padding="20">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <DataGrid x:Name="SampleDataGrid" Style="{StaticResource ModernDataGridStyle}" />
      </ScrollViewer>
    </Border>
    <Border Grid.Row="2" Background="#f3f2f1" BorderBrush="#d1d2d3" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid>
        <TextBlock x:Name="StatusText" Text="No data available" FontSize="11" Foreground="#605e5c" VerticalAlignment="Center" />
        <Button Content="Close" HorizontalAlignment="Right" Width="80" Height="32" Background="#f3f2f1" Foreground="#323130" BorderBrush="#d1d2d3" BorderThickness="1" Cursor="Hand" FontSize="12" Click="CloseButton_Click">
          <FrameworkElement.Style>
            <Style TargetType="{x:Type Button}">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Control.Padding}">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <Style.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#e1e1e1" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Background" Value="#d1d1d1" />
                </Trigger>
              </Style.Triggers>
            </Style>
          </FrameworkElement.Style>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>