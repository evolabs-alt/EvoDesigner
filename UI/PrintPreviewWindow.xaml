<Window x:Class="EvoDesigner.UI.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print Preview" Height="600" Width="900" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Header with navigation -->
        <Grid Grid.Row="0" Margin="20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="1" Text="Print Preview" FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" />
            
            <!-- Label Size Information -->
            <TextBlock Grid.Column="1" x:Name="LabelSizeInfo" Text="Label Size: 70mm × 30mm" 
                       FontSize="12" Foreground="#666666" HorizontalAlignment="Center" 
                       Margin="0,20,0,0" />
            
            <!-- Record Navigation -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" 
                        Margin="0,25,0,0" x:Name="NavigationPanel" Visibility="Collapsed">
                <Button x:Name="PrevButton" Content="◀ Previous" Width="80" Height="25" 
                        Margin="0,0,10,0" Click="PrevRecord_Click" />
                <TextBlock x:Name="RecordCounter" Text="Record 1 of 1" FontSize="12" 
                           VerticalAlignment="Center" Margin="10,0" />
                <Button x:Name="NextButton" Content="Next ▶" Width="80" Height="25" 
                        Margin="10,0,0,0" Click="NextRecord_Click" />
            </StackPanel>
        </Grid>
        
        <!-- Preview Area with distinct background colors -->
        <ScrollViewer Grid.Row="1" Margin="20" HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto" Background="#E0E0E0">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border BorderBrush="#333" BorderThickness="2" CornerRadius="4" 
                        Background="#D0D0D0" Padding="20">
                    <Border BorderBrush="#666" BorderThickness="1" Background="#F8F8FF">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="3" Opacity="0.3"/>
                        </Border.Effect>
                        <Canvas x:Name="PreviewCanvas" Background="#F8F8FF" />
                    </Border>
                </Border>
            </Grid>
        </ScrollViewer>
        
        <!-- Footer with buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" 
                    Margin="20,10">
            <Button Content="Print" Width="80" Height="30" Margin="0,0,10,0" Click="Print_Click" />
            <Button Content="Close" Width="80" Height="30" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
