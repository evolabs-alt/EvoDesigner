<Window x:Class="EvoDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EvoDesigner"
        mc:Ignorable="d"
        Title="EvoDesigner - Label Designer" Height="450" Width="800"
        Closing="MainWindow_Closing">
    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New Template" x:Name="NewMenuItem" Click="New_Click" />
                <Separator />
                <MenuItem Header="_Load Template..." x:Name="LoadTemplateMenuItem" Click="LoadTemplate_Click" />
                <MenuItem Header="_Save Template" x:Name="SaveTemplateMenuItem" Click="SaveTemplate_Click" />
                <MenuItem Header="Save Template _As..." x:Name="SaveAsTemplateMenuItem" Click="SaveAsTemplate_Click" />
                <Separator />
                <MenuItem Header="_Setup Data Source..." x:Name="SetupDataSourceMenuItem" Click="DataSource_Click" />
                <MenuItem Header="Setup _Map Fields..." x:Name="MapFieldsMenuItem" Click="MapFields_Click" />
                <Separator />
                <MenuItem Header="_Print..." x:Name="PrintPreviewMenuItem" Click="PrintPreview_Click" />
                <Separator />
                <MenuItem Header="E_xit" x:Name="ExitMenuItem" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_About">
                <MenuItem Header="_About EvoDesigner..." x:Name="AboutMenuItem" Click="About_Click" />
            </MenuItem>
        </Menu>
        
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" /> <!-- Toolbox -->
            <ColumnDefinition Width="*" />   <!-- Canvas -->
            <ColumnDefinition Width="250" /> <!-- Setup/Properties -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Bar -->
            <RowDefinition Height="*" />    <!-- Main -->
        </Grid.RowDefinitions>

        <!-- Top Bar: Actions -->
        <StackPanel Grid.ColumnSpan="3" Grid.Row="0" Orientation="Horizontal" Margin="10">
            <!-- Grid Controls Group -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="8,5,8,5" Margin="0,0,15,0" Background="#FAFAFA">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⊞ Grid:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#444" FontSize="11"/>
                    <CheckBox x:Name="ShowGridCheckBox" Content="Show Grid (5mm)" IsChecked="True" VerticalAlignment="Center" ToolTip="Toggle 5mm gridlines" FontSize="11"/>
                </StackPanel>
            </Border>
            
            <!-- Layer Controls Group -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="8,5,8,5" Margin="0,0,15,0" Background="#FAFAFA">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📊 Layer:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#444" FontSize="11"/>
                    <StackPanel x:Name="LayerControlsContainer" Orientation="Horizontal">
                        <!-- Layer control buttons will be added here dynamically -->
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- Zoom Controls Group -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="8,5,8,5" Background="#FAFAFA">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍 Zoom:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#444" FontSize="11"/>
                    <Button x:Name="ZoomOutButton" Content="−" Width="28" Height="25" Margin="0,0,3,0" ToolTip="Zoom Out" FontSize="14" FontWeight="Bold"/>
                    <TextBlock x:Name="ZoomTextBlock" Text="100%" VerticalAlignment="Center" Width="45" TextAlignment="Center" Margin="3,0,3,0" FontWeight="SemiBold" Foreground="#333"/>
                    <Button x:Name="ZoomInButton" Content="+" Width="28" Height="25" Margin="3,0,8,0" ToolTip="Zoom In" FontSize="12" FontWeight="Bold"/>
                    <Button x:Name="ZoomFitButton" Content="⊞" Width="32" Height="25" Margin="0,0,3,0" ToolTip="Zoom to Fit" FontSize="12"/>
                    <Button x:Name="ZoomResetButton" Content="1:1" Width="35" Height="25" ToolTip="Reset Zoom (100%)" FontSize="10"/>
                </StackPanel>
            </Border>
            
            <!-- Data Controls Group -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="3" Padding="8,5,8,5" Margin="15,0,0,0" Background="#FAFAFA">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📊 Data:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" Foreground="#444" FontSize="11"/>
                    <Button x:Name="RefreshDataButton" Content="⟳ Refresh" Width="70" Height="25" ToolTip="Refresh data from configured data source" FontSize="11" Click="RefreshData_Click"/>
                    <TextBlock x:Name="DataStatusTextBlock" Text="No data" VerticalAlignment="Center" Margin="8,0,0,0" FontStyle="Italic" Foreground="#666" FontSize="10"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Toolbox -->
        <ScrollViewer Grid.Column="0" Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto">
            <StackPanel Background="#F0F4F8" Margin="0,0,10,0">
                <TextBlock Text="Toolbox" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#2D5A8D" />
                
                <!-- Basic Elements -->
                <TextBlock Text="Basic Elements" FontWeight="Bold" FontSize="12" Margin="0,0,0,5" Foreground="#4A5568" />
                <Button Content="🅣 Text" Margin="0,0,0,3" ToolTip="Add text element" FontSize="12" />
                <Button Content="🖼 Image" Margin="0,0,0,5" ToolTip="Add image element" FontSize="12" />
                
                <!-- Retail Checkout -->
                <TextBlock Text="Retail Checkout" FontWeight="Bold" FontSize="12" Margin="0,10,0,5" Foreground="#4A5568" />
                <Button Content="📊 EAN-13" Margin="0,0,0,3" ToolTip="European Article Number 13-digit" FontSize="12" />
                <Button Content="📊 EAN-8" Margin="0,0,0,3" ToolTip="European Article Number 8-digit" FontSize="12" />
                <Button Content="📊 UPC-A" Margin="0,0,0,3" ToolTip="Universal Product Code A" FontSize="12" />
                <Button Content="📊 UPC-E" Margin="0,0,0,5" ToolTip="Universal Product Code E" FontSize="12" />
                
                <!-- Logistics -->
                <TextBlock Text="Logistics" FontWeight="Bold" FontSize="12" Margin="0,10,0,5" Foreground="#4A5568" />
                <Button Content="📋 Code 128" Margin="0,0,0,3" ToolTip="High-density linear barcode" FontSize="12" />
                <Button Content="📋 Code 39" Margin="0,0,0,5" ToolTip="Alphanumeric barcode" FontSize="12" />
                
                <!-- Mobile/Consumer -->
                <TextBlock Text="Mobile/Consumer" FontWeight="Bold" FontSize="12" Margin="0,10,0,5" Foreground="#4A5568" />
                <Button Content="� QR Code" Margin="0,0,0,3" ToolTip="Quick Response code" FontSize="12" />
                <Button Content="📱 Aztec" Margin="0,0,0,5" ToolTip="Aztec code" FontSize="12" />
                
                <!-- Healthcare/Industrial -->
                <TextBlock Text="Healthcare/Industrial" FontWeight="Bold" FontSize="12" Margin="0,10,0,5" Foreground="#4A5568" />
                <Button Content="🏥 Data Matrix" Margin="0,0,0,3" ToolTip="2D matrix barcode" FontSize="12" />
                <Button Content="🏥 GS1 DataBar" Margin="0,0,0,5" ToolTip="GS1 DataBar (RSS)" FontSize="12" />
                
                <!-- Government -->
                <TextBlock Text="Government" FontWeight="Bold" FontSize="12" Margin="0,10,0,5" Foreground="#4A5568" />
                <Button Content="🏛 PDF417" Margin="0,0,0,5" ToolTip="Portable Data File 417" FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <!-- Label Canvas with Rulers and Guidelines -->
        <Grid Grid.Column="1" Grid.Row="1" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="25" /> <!-- Top Ruler -->
                <RowDefinition Height="*" />  <!-- Canvas Area -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="25" /> <!-- Left Ruler -->
                <ColumnDefinition Width="*" />  <!-- Canvas Area -->
            </Grid.ColumnDefinitions>
            
            <!-- Top Ruler -->
            <Canvas x:Name="TopRuler" Grid.Column="1" Grid.Row="0" Background="#E8E8E8" Height="25" ClipToBounds="True">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="TopRulerScaleTransform" ScaleX="1" ScaleY="1" />
                </Canvas.RenderTransform>
                <Canvas.RenderTransformOrigin>0.5,0</Canvas.RenderTransformOrigin>
                <!-- Ruler marks will be added programmatically -->
            </Canvas>
            
            <!-- Left Ruler -->
            <Canvas x:Name="LeftRuler" Grid.Column="0" Grid.Row="1" Background="#E8E8E8" Width="25" ClipToBounds="True">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="LeftRulerScaleTransform" ScaleX="1" ScaleY="1" />
                </Canvas.RenderTransform>
                <Canvas.RenderTransformOrigin>0,0.5</Canvas.RenderTransformOrigin>
                <!-- Ruler marks will be added programmatically -->
            </Canvas>
            
            <!-- Corner -->
            <Rectangle Grid.Column="0" Grid.Row="0" Fill="#D0D0D0" />
            
            <!-- Canvas Container -->
            <Border Grid.Column="1" Grid.Row="1" Background="#FFF" BorderBrush="#888" BorderThickness="2" CornerRadius="0">
                <ScrollViewer x:Name="CanvasScrollViewer" 
                             HorizontalScrollBarVisibility="Auto" 
                             VerticalScrollBarVisibility="Auto"
                             CanContentScroll="True">
                    <Grid x:Name="CanvasContainer" MouseLeftButtonDown="CanvasContainer_MouseLeftButtonDown">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
                        
                        <!-- Background Grid -->
                        <Canvas x:Name="GridCanvas" Background="#FEFEFE" MouseLeftButtonDown="CanvasContainer_MouseLeftButtonDown" />
                        
                        <!-- Main Label Canvas -->
                        <Canvas x:Name="LabelCanvas" Background="Transparent" AllowDrop="True" />
                        
                        <!-- Margin Guidelines (on top for visibility) -->
                        <Canvas x:Name="MarginCanvas" Background="Transparent" IsHitTestVisible="False" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Setup/Properties Panel -->
        <StackPanel Grid.Column="2" Grid.Row="1" Margin="10">
            <!-- Template Properties Section -->
            <TextBlock Text="Label Setup" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#2D5A8D" />
            <TextBlock Text="Template Name:" ToolTip="Name for your label template" />
            <TextBox x:Name="TemplateNameBox" Margin="0,0,0,10" />
            
            <!-- Label Size Display (Read-only) -->
            <TextBlock Text="Label Size:" FontWeight="Bold" Margin="0,0,0,5" Foreground="#2D5A8D" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="Width:" Margin="0,0,5,0" />
                <TextBlock x:Name="LabelWidthDisplay" Text="70.0 mm" FontWeight="SemiBold" Margin="0,0,15,0" />
                <TextBlock Text="Height:" Margin="0,0,5,0" />
                <TextBlock x:Name="LabelHeightDisplay" Text="30.0 mm" FontWeight="SemiBold" />
            </StackPanel>
            <Button x:Name="ResizeButton" Content="Resize" Width="80" HorizontalAlignment="Left" 
                    Margin="0,0,0,10" Click="ResizeButton_Click" ToolTip="Resize the label and optionally adjust elements" />
            
            <TextBlock Text="Margins (mm):" FontWeight="Bold" Margin="0,10,0,0" Foreground="#2D5A8D" ToolTip="Set label margins in millimeters" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Left:" Margin="0,0,5,0" ToolTip="Left margin" />
                <TextBox x:Name="MarginLeftBox" Width="40" Margin="0,0,10,0" />
                <TextBlock Text="Right:" Margin="0,0,5,0" ToolTip="Right margin" />
                <TextBox x:Name="MarginRightBox" Width="40" Margin="0,0,10,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,10">
                <TextBlock Text="Top:" Margin="0,0,5,0" ToolTip="Top margin" />
                <TextBox x:Name="MarginTopBox" Width="40" Margin="0,0,10,0" />
                <TextBlock Text="Bottom:" Margin="0,0,5,0" ToolTip="Bottom margin" />
                <TextBox x:Name="MarginBottomBox" Width="40" />
            </StackPanel>
            
            <!-- Separator -->
            <Separator Margin="0,10,0,10"/>
            
            <!-- Element Properties Section -->
            <TextBlock Text="Element Properties" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#2D5A8D" />
            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ElementPropertiesPanel">
                    <TextBlock Text="Select an element to view its properties" 
                              Foreground="Gray" FontStyle="Italic" 
                              TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Grid>
</DockPanel>
</Window>
