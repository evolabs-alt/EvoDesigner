<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TaggJack.UI.ErpImportWizardWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Import from ERP" Height="620" Width="820" WindowStartupLocation="CenterScreen" xmlns:ui="clr-namespace:TaggJack.UI">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Import Items from ERP" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
    <Grid Grid.Row="1">
      <StackPanel x:Name="Step1Panel" Visibility="Visible">
        <TextBlock Text="Step 1: Database Type" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ComboBox x:Name="DatabaseTypeCombo" Height="30" Margin="0,0,0,12" />
      </StackPanel>
      <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
        <TextBlock Text="Step 2: Connection" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Host" VerticalAlignment="Center" />
          <TextBox x:Name="HostBox" Grid.Column="1" Height="28" Margin="0,0,0,8" />
          <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center" />
          <TextBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,0,8" />
          <TextBlock Grid.Row="2" Text="Database" VerticalAlignment="Center" />
          <TextBox x:Name="DatabaseBox" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,0,0,8" />
          <TextBlock Grid.Row="3" Text="Username" VerticalAlignment="Center" />
          <TextBox x:Name="UsernameBox" Grid.Row="3" Grid.Column="1" Height="28" Margin="0,0,0,8" />
          <TextBlock Grid.Row="4" Text="Password" VerticalAlignment="Center" />
          <PasswordBox x:Name="PasswordBox" Grid.Row="4" Grid.Column="1" Height="28" />
        </Grid>
        <Button Content="Test Connection" Width="130" Height="30" Margin="0,12,0,0" HorizontalAlignment="Left" Click="TestConnection_Click" />
      </StackPanel>
      <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
        <TextBlock Text="Step 3: Source Query" FontWeight="SemiBold" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <Button Content="Load Tables" Width="110" Height="30" Margin="0,0,8,0" Click="LoadTables_Click" />
          <ComboBox x:Name="TablesCombo" Width="300" Height="30" SelectionChanged="TablesCombo_SelectionChanged" />
        </StackPanel>
        <TextBox x:Name="QueryBox" AcceptsReturn="True" TextWrapping="Wrap" Height="220" VerticalScrollBarVisibility="Auto" />
      </StackPanel>
      <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
        <TextBlock Text="Step 4: Map Fields" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Item Code" VerticalAlignment="Center" />
          <ComboBox x:Name="ItemCodeFieldCombo" Grid.Column="1" Height="28" Margin="0,0,0,8" />
          <TextBlock Grid.Row="1" Text="GTIN" VerticalAlignment="Center" />
          <ComboBox x:Name="GtinFieldCombo" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,0,8" />
          <TextBlock Grid.Row="2" Text="Description" VerticalAlignment="Center" />
          <ComboBox x:Name="DescriptionFieldCombo" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,0,0,8" />
          <TextBlock Grid.Row="3" Text="Level 1" VerticalAlignment="Center" />
          <ComboBox x:Name="Level1FieldCombo" Grid.Row="3" Grid.Column="1" Height="28" Margin="0,0,0,8" />
          <TextBlock Grid.Row="4" Text="Level 2" VerticalAlignment="Center" />
          <ComboBox x:Name="Level2FieldCombo" Grid.Row="4" Grid.Column="1" Height="28" Margin="0,0,0,8" />
          <TextBlock Grid.Row="5" Text="Level 3" VerticalAlignment="Center" />
          <ComboBox x:Name="Level3FieldCombo" Grid.Row="5" Grid.Column="1" Height="28" />
        </Grid>
      </StackPanel>
      <StackPanel x:Name="Step5Panel" Visibility="Collapsed">
        <TextBlock Text="Step 5: Preview and Import" FontWeight="SemiBold" Margin="0,0,0,8" />
        <Button Content="Load Preview" Width="120" Height="30" Margin="0,0,0,8" HorizontalAlignment="Left" Click="LoadPreview_Click" />
        <DataGrid x:Name="PreviewGrid" Height="300" AutoGenerateColumns="True" IsReadOnly="True" />
      </StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <TextBlock x:Name="StepIndicatorText" Text="Step 1 of 5" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BackButton" Content="Back" Width="90" Height="32" Margin="0,0,8,0" IsEnabled="False" Click="Back_Click" />
        <Button x:Name="NextButton" Content="Next" Width="90" Height="32" Margin="0,0,8,0" Click="Next_Click" />
        <Button x:Name="ImportButton" Content="Import" Width="90" Height="32" Visibility="Collapsed" Click="Import_Click" />
        <Button Content="Close" Width="90" Height="32" Click="Close_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>