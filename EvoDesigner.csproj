<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    
    <!-- Application Metadata for Installer -->
    <AssemblyTitle>TaggJack</AssemblyTitle>
    <AssemblyDescription>Professional Label Design Application for Printable Labels</AssemblyDescription>
    <AssemblyCompany>Evolabs IT Solutions Ltd</AssemblyCompany>
    <AssemblyProduct>TaggJack</AssemblyProduct>
    <AssemblyCopyright>Copyright © 2025 Evolabs IT Solutions Ltd</AssemblyCopyright>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    
    <!-- Installer Properties -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
  <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  <PackageReference Include="MySql.Data" Version="9.4.0" />
  <PackageReference Include="QRCoder" Version="1.6.0" />
  <PackageReference Include="System.Drawing.Common" Version="9.0.8" />
  <PackageReference Include="ZXing.Net" Version="0.16.10" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Logo.png" />
    <Resource Include="icon.png" />
    <Content Include="Logo.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="icon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
