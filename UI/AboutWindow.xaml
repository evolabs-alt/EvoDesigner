<Window x:Class="EvoDesigner.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About TaggJack" Height="450" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#f3f2f1"/>
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="BorderBrush" Value="#d1d2d3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0078d4"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#106ebe"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005a9e"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel Background -->
        <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ffffff" Offset="0"/>
            <GradientStop Color="#f8f9fa" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Border Background="{StaticResource PanelGradient}" BorderBrush="#d1d2d3" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Logo/Icon -->
            <Border Grid.Row="0" Width="100" Height="100" 
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <Image Source="/icon.png" 
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            
            <!-- Application Name -->
            <TextBlock Grid.Row="1" Text="TaggJack" FontSize="28" FontWeight="Bold" 
                       Foreground="#0078d4" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            
            <!-- Tagline -->
            <TextBlock Grid.Row="2" Text="Professional Label Designer" FontSize="14" 
                       Foreground="#605e5c" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            
            <!-- Version Info -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,16">
                <TextBlock Text="Version 1.0.0" FontSize="12" Foreground="#323130" 
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock Text="Build 2025.09.06" FontSize="10" Foreground="#605e5c" 
                           HorizontalAlignment="Center"/>
            </StackPanel>
            
            <!-- Copyright -->
            <TextBlock Grid.Row="4" Text="© 2025 Evolabs IT Solutions Ltd" FontSize="11" 
                       Foreground="#323130" HorizontalAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Grid.Row="5" Text="All Rights Reserved" FontSize="10" 
                       Foreground="#605e5c" HorizontalAlignment="Center" Margin="0,0,0,16"/>
            
            <!-- Contact Info -->
            <StackPanel Grid.Row="6" HorizontalAlignment="Center" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                    <TextBlock Text="🌐" FontSize="12" Margin="0,0,4,0"/>
                    <TextBlock Text="www.evolabs.co" FontSize="11" Foreground="#0078d4" 
                               TextDecorations="Underline" Cursor="Hand" MouseLeftButtonUp="Website_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="📧" FontSize="12" Margin="0,0,4,0"/>
                    <TextBlock Text="support@evolabs.co" FontSize="11" Foreground="#0078d4" 
                               TextDecorations="Underline" Cursor="Hand" MouseLeftButtonUp="Email_Click"/>
                </StackPanel>
            </StackPanel>
            
            <!-- OK Button -->
            <Button Grid.Row="7" Content="OK" Width="100" Style="{StaticResource ModernButtonStyle}" 
                    HorizontalAlignment="Center" Click="OK_Click" IsDefault="True" Margin="0,16,0,16"/>
        </Grid>
    </Border>
</Window>
