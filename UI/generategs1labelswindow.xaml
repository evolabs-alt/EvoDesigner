<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TaggJack.UI.GenerateGs1LabelsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Generate GS1 Labels" Height="820" Width="700" WindowStartupLocation="CenterScreen" xmlns:ui="clr-namespace:TaggJack.UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Text="Generate GS1 Labels" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />
      <TextBlock Grid.Row="1" Text="Item" Margin="0,0,0,4" />
      <ComboBox x:Name="ItemCombo" Grid.Row="2" Height="30" Margin="0,0,0,12" DisplayMemberPath="ItemCode" SelectionChanged="ItemCombo_SelectionChanged" />
      <TextBlock Grid.Row="3" Text="Description" Margin="0,0,0,4" />
      <TextBox x:Name="DescriptionBox" Grid.Row="4" Height="28" IsReadOnly="True" Margin="0,0,0,12" />
      <TextBlock Grid.Row="5" Text="GTIN" Margin="0,0,0,4" />
      <TextBox x:Name="GtinBox" Grid.Row="6" Height="28" IsReadOnly="True" Margin="0,0,0,12" />
      <TextBlock Grid.Row="7" Text="Quantity" Margin="0,0,0,4" />
      <TextBox x:Name="QuantityBox" Grid.Row="8" Height="28" Margin="0,0,0,12" TextChanged="QuantityBox_TextChanged" />
      <Border Grid.Row="9" Background="#f3f2f1" Padding="12" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock x:Name="Level1CountText" Text="Level 1 serials: -" />
          <TextBlock x:Name="Level2CountText" Text="Level 2 serials: -" Margin="0,4,0,0" />
          <TextBlock x:Name="Level3CountText" Text="Level 3 serials: -" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
      <TextBlock Grid.Row="10" Text="Batch" Margin="0,0,0,4" />
      <TextBox x:Name="BatchBox" Grid.Row="11" Height="28" Margin="0,0,0,12" />
      <Grid Grid.Row="12" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="Production Date" />
          <DatePicker x:Name="ProductionDatePicker" Height="28" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <TextBlock Text="Expiry Date" />
          <DatePicker x:Name="ExpiryDatePicker" Height="28" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="13" Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,8,0">
          <TextBlock Text="From GLN" Margin="0,0,0,4" />
          <TextBox x:Name="FromGlnBox" Height="28" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <TextBlock Text="To GLN" Margin="0,0,0,4" />
          <TextBox x:Name="ToGlnBox" Height="28" />
        </StackPanel>
      </Grid>
      <TextBlock Grid.Row="14" Text="Order Number" Margin="0,0,0,4" />
      <TextBox x:Name="OrderNumberBox" Grid.Row="15" Height="28" Margin="0,0,0,12" />
      <TextBlock Grid.Row="16" Text="Templates and printers per level" FontWeight="SemiBold" Margin="0,0,0,8" />
      <Grid Grid.Row="17" Margin="0,0,0,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="70" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Level 1" VerticalAlignment="Center" />
        <TextBox x:Name="Level1TemplateBox" Grid.Column="1" Height="28" Margin="4,0,4,8" />
        <Button Grid.Column="2" Content="..." Width="30" Height="28" Margin="0,0,4,8" Click="BrowseLevel1Template_Click" />
        <ComboBox x:Name="Level1PrinterCombo" Grid.Column="3" Height="28" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Text="Level 2" VerticalAlignment="Center" />
        <TextBox x:Name="Level2TemplateBox" Grid.Row="1" Grid.Column="1" Height="28" Margin="4,0,4,8" />
        <Button Grid.Row="1" Grid.Column="2" Content="..." Width="30" Height="28" Margin="0,0,4,8" Click="BrowseLevel2Template_Click" />
        <ComboBox x:Name="Level2PrinterCombo" Grid.Row="1" Grid.Column="3" Height="28" Margin="0,0,0,8" />
        <TextBlock Grid.Row="2" Text="Level 3" VerticalAlignment="Center" />
        <TextBox x:Name="Level3TemplateBox" Grid.Row="2" Grid.Column="1" Height="28" Margin="4,0,4,0" />
        <Button Grid.Row="2" Grid.Column="2" Content="..." Width="30" Height="28" Margin="0,0,4,0" Click="BrowseLevel3Template_Click" />
        <ComboBox x:Name="Level3PrinterCombo" Grid.Row="2" Grid.Column="3" Height="28" />
      </Grid>
      <TextBlock x:Name="StatusText" Grid.Row="18" Foreground="#605e5c" Margin="0,0,0,12" />
      <StackPanel Grid.Row="19" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="GS1 Settings..." Width="120" Height="32" Margin="0,0,8,0" Click="Settings_Click" />
        <Button Content="Close" Width="90" Height="32" Margin="0,0,8,0" Click="Close_Click" />
        <Button x:Name="SubmitButton" Content="Submit" Width="90" Height="32" IsDefault="True" Click="Submit_Click" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>