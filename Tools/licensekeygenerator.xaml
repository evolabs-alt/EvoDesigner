<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TaggJack.Tools.LicenseKeyGenerator" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TaggJack License Key Generator (Vendor Tool)" Height="700" Width="900" WindowStartupLocation="CenterScreen" Background="#F5F5F5" xmlns:tools="clr-namespace:TaggJack.Tools">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type GroupBox}" TargetType="{x:Type GroupBox}">
        <Setter Property="Margin" Value="10" />
        <Setter Property="Padding" Value="15" />
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#007ACC" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="BorderBrush" Value="#CCCCCC" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="FontSize" Value="13" />
      </Style>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="Padding" Value="20,10" />
        <Setter Property="Margin" Value="5" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="#007ACC" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#005A9E" />
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter Property="Background" Value="#CCCCCC" />
            <Setter Property="FrameworkElement.Cursor" Value="Arrow" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ReadOnlyTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="TextBoxBase.IsReadOnly" Value="True" />
        <Setter Property="Background" Value="#F0F0F0" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
      </Style>
      <Style x:Key="SecondaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#6C757D" />
        <Style.Triggers>
          <Trigger Property="UIElement.IsMouseOver" Value="True">
            <Setter Property="Background" Value="#545B62" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="TaggJack License Key Generator" FontSize="24" FontWeight="Bold" Foreground="#007ACC" HorizontalAlignment="Center" />
      <TextBlock Text="Vendor Tool - Generate License Keys for Customers" FontSize="13" Foreground="#666666" HorizontalAlignment="Center" Margin="0,5,0,0" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <GroupBox Header="Customer Information">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Customer Name:" VerticalAlignment="Center" Margin="5" />
            <TextBox x:Name="CustomerNameTextBox" Grid.Row="0" Grid.Column="1" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Customer Email:" VerticalAlignment="Center" Margin="5" />
            <TextBox x:Name="CustomerEmailTextBox" Grid.Row="1" Grid.Column="1" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Company:" VerticalAlignment="Center" Margin="5" />
            <TextBox x:Name="CompanyTextBox" Grid.Row="2" Grid.Column="1" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="Notes:" VerticalAlignment="Center" Margin="5" />
            <TextBox x:Name="NotesTextBox" Grid.Row="3" Grid.Column="1" Height="60" TextWrapping="Wrap" AcceptsReturn="True" />
          </Grid>
        </GroupBox>
        <GroupBox Header="License Configuration">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="License Type:" VerticalAlignment="Center" Margin="5" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="Standard (1 PC)" IsReadOnly="True" Background="#F0F0F0" Padding="8" Margin="5" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Expiry Date:" VerticalAlignment="Center" Margin="5" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="5">
              <CheckBox x:Name="PerpetualCheckBox" Content="Perpetual (No Expiry)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,20,0" Checked="PerpetualCheckBox_Changed" Unchecked="PerpetualCheckBox_Changed" />
              <DatePicker x:Name="ExpiryDatePicker" IsEnabled="False" SelectedDateFormat="Long" Width="250" />
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Features Included:" VerticalAlignment="Top" Margin="5,10,5,5" />
            <TextBlock x:Name="FeaturesTextBlock" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="5,10,5,5" FontSize="12" Foreground="#333333" />
          </Grid>
        </GroupBox>
        <GroupBox Header="Generated License Key">
          <StackPanel>
            <TextBox x:Name="GeneratedKeyTextBox" Style="{StaticResource ReadOnlyTextBox}" Text="Click 'Generate Key' to create a license" TextAlignment="Center" FontSize="16" />
            <Grid Margin="5,10,5,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button x:Name="GenerateKeyButton" Grid.Column="0" Content="🔑 Generate License Key" HorizontalAlignment="Stretch" Click="GenerateKeyButton_Click" />
              <Button x:Name="CopyKeyButton" Grid.Column="1" Content="📋 Copy Key" IsEnabled="False" Style="{StaticResource SecondaryButton}" Click="CopyKeyButton_Click" />
              <Button x:Name="SaveRecordButton" Grid.Column="2" Content="💾 Save Record" IsEnabled="False" Style="{StaticResource SecondaryButton}" Click="SaveRecordButton_Click" />
            </Grid>
            <TextBlock x:Name="StatusMessageTextBlock" Margin="5,10,5,0" FontSize="12" FontStyle="Italic" TextWrapping="Wrap" HorizontalAlignment="Center" />
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Recent License Keys Generated">
          <StackPanel>
            <DataGrid x:Name="HistoryDataGrid" Height="200" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Margin="0,0,0,10">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Width="140" Binding="{Binding GeneratedDate}" />
                <DataGridTextColumn Header="License Key" Width="180" Binding="{Binding LicenseKey}" />
                <DataGridTextColumn Header="Type" Width="80" Binding="{Binding LicenseType}" />
                <DataGridTextColumn Header="Expiry" Width="100" Binding="{Binding ExpiryDate}" />
                <DataGridTextColumn Header="Customer" Width="130" Binding="{Binding CustomerName}" />
                <DataGridTextColumn Header="Email" Width="*" Binding="{Binding CustomerEmail}" />
              </DataGrid.Columns>
            </DataGrid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="HistoryCountTextBlock" Grid.Column="0" Text="0 licenses generated" VerticalAlignment="Center" Margin="5" FontSize="12" Foreground="#666666" />
              <Button Grid.Column="1" Content="📊 Export to CSV" Style="{StaticResource SecondaryButton}" Click="ExportButton_Click" />
              <Button Grid.Column="2" Content="🗑️ Clear History" Style="{StaticResource SecondaryButton}" Click="ClearHistoryButton_Click" />
            </Grid>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Margin="0,20,0,0">
      <Separator Margin="0,0,0,10" />
      <TextBlock Text="⚠️ VENDOR USE ONLY - Keep generated keys secure and track all customer activations" FontSize="11" Foreground="#DC3545" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Text="License Key Format: TJ11-XXXX-XXXX-XXXX-XXXX (16 random characters + checksum)" FontSize="10" Foreground="#666666" HorizontalAlignment="Center" Margin="0,5,0,0" />
    </StackPanel>
  </Grid>
</Window>