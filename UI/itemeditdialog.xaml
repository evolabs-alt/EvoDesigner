<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TaggJack.UI.ItemEditDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Item" Height="420" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" xmlns:ui="clr-namespace:TaggJack.UI">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Item Code" Margin="0,0,0,4" />
    <TextBox x:Name="ItemCodeBox" Grid.Row="1" Height="28" Margin="0,0,0,12" />
    <TextBlock Grid.Row="2" Text="GTIN" Margin="0,0,0,4" />
    <TextBox x:Name="GtinBox" Grid.Row="3" Height="28" Margin="0,0,0,12" />
    <TextBlock Grid.Row="4" Text="Description" Margin="0,0,0,4" />
    <TextBox x:Name="DescriptionBox" Grid.Row="5" Height="28" Margin="0,0,0,12" />
    <Grid Grid.Row="6" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,8,0">
        <TextBlock Text="Level 1" />
        <TextBox x:Name="Level1Box" Height="28" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="4,0">
        <TextBlock Text="Level 2" />
        <TextBox x:Name="Level2Box" Height="28" />
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="8,0,0,0">
        <TextBlock Text="Level 3" />
        <TextBox x:Name="Level3Box" Height="28" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Width="90" Height="32" Margin="0,0,8,0" Click="Cancel_Click" />
      <Button Content="Save" Width="90" Height="32" IsDefault="True" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>