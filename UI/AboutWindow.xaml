<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TaggJack.UI.AboutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="About TaggJack" Height="450" Width="450" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" xmlns:ui="clr-namespace:TaggJack.UI">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="ModernButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#f3f2f1" />
        <Setter Property="Foreground" Value="#323130" />
        <Setter Property="BorderBrush" Value="#d1d2d3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="4">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Control.Padding}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#0078d4" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                  <Setter Property="BorderBrush" Value="#106ebe" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter Property="Background" Value="#005a9e" />
                  <Setter Property="Foreground" Value="#FFFFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ffffff" Offset="0" />
        <GradientStop Color="#f8f9fa" Offset="1" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </Window.Resources>
  <Border Background="{StaticResource PanelGradient}" BorderBrush="#d1d2d3" BorderThickness="1">
    <Grid Margin="24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,16">
        <Image Source="/icon.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
      </Border>
      <TextBlock Grid.Row="1" Text="TaggJack" FontSize="28" FontWeight="Bold" Foreground="#0078d4" HorizontalAlignment="Center" Margin="0,0,0,4" />
      <TextBlock Grid.Row="2" Text="Professional Label Designer" FontSize="14" Foreground="#605e5c" HorizontalAlignment="Center" Margin="0,0,0,16" />
      <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,16">
        <TextBlock Text="Version 1.1.0" FontSize="12" Foreground="#323130" HorizontalAlignment="Center" Margin="0,0,0,2" />
        <TextBlock Text="Build 2025.10.11" FontSize="10" Foreground="#605e5c" HorizontalAlignment="Center" />
      </StackPanel>
      <Border Grid.Row="4" Background="#f0f8ff" BorderBrush="#0078d4" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="License Information" FontSize="12" FontWeight="SemiBold" Foreground="#0078d4" HorizontalAlignment="Center" Margin="0,0,0,8" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="License Type:" FontSize="11" Foreground="#605e5c" Margin="0,0,8,4" HorizontalAlignment="Right" />
            <TextBlock x:Name="LicenseTypeText" Grid.Row="0" Grid.Column="1" FontSize="11" Foreground="#323130" Margin="0,0,0,4" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Licensed To:" FontSize="11" Foreground="#605e5c" Margin="0,0,8,4" HorizontalAlignment="Right" />
            <TextBlock x:Name="LicensedToText" Grid.Row="1" Grid.Column="1" FontSize="11" Foreground="#323130" Margin="0,0,0,4" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Expiry:" FontSize="11" Foreground="#605e5c" Margin="0,0,8,4" HorizontalAlignment="Right" />
            <TextBlock x:Name="ExpiryText" Grid.Row="2" Grid.Column="1" FontSize="11" Foreground="#323130" Margin="0,0,0,4" />
            <TextBlock Grid.Row="3" Grid.Column="0" Text="License Key:" FontSize="11" Foreground="#605e5c" Margin="0,0,8,0" HorizontalAlignment="Right" />
            <TextBlock x:Name="LicenseKeyText" Grid.Row="3" Grid.Column="1" FontSize="10" Foreground="#605e5c" FontFamily="Consolas" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>
      <TextBlock Grid.Row="5" Text="© 2025 Evolabs IT Solutions" FontSize="11" Foreground="#323130" HorizontalAlignment="Center" Margin="0,0,0,4" />
      <TextBlock Grid.Row="5" Text="All Rights Reserved" FontSize="10" Foreground="#605e5c" HorizontalAlignment="Center" Margin="0,4,0,16" VerticalAlignment="Bottom" />
      <StackPanel Grid.Row="6" HorizontalAlignment="Center" Margin="0,0,0,16">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
          <TextBlock Text="🌐" FontSize="12" Margin="0,0,4,0" />
          <TextBlock Text="www.evolabs.co" FontSize="11" Foreground="#0078d4" TextDecorations="Underline" Cursor="Hand" MouseLeftButtonUp="Website_Click" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <TextBlock Text="📧" FontSize="12" Margin="0,0,4,0" />
          <TextBlock Text="support@evolabs.co" FontSize="11" Foreground="#0078d4" TextDecorations="Underline" Cursor="Hand" MouseLeftButtonUp="Email_Click" />
        </StackPanel>
      </StackPanel>
      <Button Grid.Row="7" Content="OK" Width="100" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Center" IsDefault="True" Margin="0,16,0,16" Click="OK_Click" />
    </Grid>
  </Border>
</Window>