<Window x:Class="EvoDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EvoDesigner"
        xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        mc:Ignorable="d"
        Title="TaggJack - Professional Label Designer" Height="800" Width="1400"
        WindowState="Maximized"
        Background="#f5f5f5"
        Focusable="True"
        KeyboardNavigation.TabNavigation="Local"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">
    
    <Window.Resources>
        <!-- Modern Light Theme Styles -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#f8f9fa"/>
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="BorderBrush" Value="#d1d2d3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0078d4"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#106ebe"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#005a9e"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolboxButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,4"/>
        </Style>

        <Style x:Key="CompactButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="MenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5,5,5,0"/>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="BorderBrush" Value="#d1d2d3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0078d4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="ModernLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="0,2"/>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#d1d2d3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#323130"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,2,28,2"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <Grid>
                                <ToggleButton Name="ToggleButton" 
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Focusable="false"
                                              IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="20"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Name="Arrow" Grid.Column="1" 
                                              Fill="#605e5c" 
                                              HorizontalAlignment="Right" 
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              Data="M 0 0 L 4 4 L 8 0 Z"/>
                                    </Grid>
                                </ToggleButton>
                                <ContentPresenter Name="ContentSite" 
                                                  IsHitTestVisible="False" 
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="8,6,28,6"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                                <TextBox x:Name="PART_EditableTextBox"
                                         Style="{x:Null}" 
                                         HorizontalAlignment="Left" 
                                         VerticalAlignment="Center" 
                                         Margin="3,6,28,6"
                                         Focusable="True" 
                                         Background="Transparent"
                                         Visibility="Hidden"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                <Popup Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True" 
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid Name="DropDown"
                                          SnapsToDevicePixels="True"                
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border x:Name="DropDownBorder"
                                                Background="White" 
                                                BorderThickness="1"
                                                BorderBrush="#d1d2d3"/>
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#0078d4"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#0078d4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0078d4"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SubHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#605e5c"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- Light Gradient Background for Panels -->
        <LinearGradientBrush x:Key="PanelGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#ffffff" Offset="0"/>
            <GradientStop Color="#f8f9fa" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ToolboxGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#faf9f8" Offset="0"/>
            <GradientStop Color="#f3f2f1" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <DockPanel>
        <!-- Modern Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="White" BorderThickness="0">
            <MenuItem Header="_File" Style="{StaticResource MenuItemStyle}">
                <MenuItem Header="_New Template" x:Name="NewMenuItem" Click="New_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🆕" FontSize="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Background="#d1d2d3"/>
                <MenuItem Header="_Load Template..." x:Name="LoadTemplateMenuItem" Click="LoadTemplate_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📁" FontSize="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Save Template" x:Name="SaveTemplateMenuItem" Click="SaveTemplate_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="💾" FontSize="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save Template _As..." x:Name="SaveAsTemplateMenuItem" Click="SaveAsTemplate_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="💾" FontSize="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Background="#d1d2d3"/>
                <MenuItem Header="_Print..." x:Name="PrintPreviewMenuItem" Click="PrintPreview_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🖨️" FontSize="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator Background="#d1d2d3"/>
                <MenuItem Header="E_xit" x:Name="ExitMenuItem" Click="Exit_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🚪" FontSize="14" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View" Style="{StaticResource MenuItemStyle}">
                <MenuItem Header="Show Grid" x:Name="ViewGridMenuItem" IsCheckable="True" IsChecked="True" 
                         Click="ShowGrid_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📏" FontSize="14" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Data" Style="{StaticResource MenuItemStyle}">
                <MenuItem Header="Setup _Data Source..." x:Name="SetupDataSourceMenuItem" Click="DataSource_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🔌" FontSize="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Setup _Map Fields..." x:Name="MapFieldsMenuItem" Click="MapFields_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="🗺️" FontSize="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Sample Data..." x:Name="SampleDataMenuItem" Click="SampleData_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="📊" FontSize="14" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Elements" Style="{StaticResource MenuItemStyle}">
                <MenuItem Header="Text" Click="MenuElement_Click" Tag="Text" />
                <MenuItem Header="Image" Click="MenuElement_Click" Tag="Image" />
                <MenuItem Header="Linked Image" Click="MenuElement_Click" Tag="LinkedImage" />
                <Separator Background="#d1d2d3"/>
                <MenuItem Header="Line" Click="MenuElement_Click" Tag="Line" />
                <MenuItem Header="Rectangle" Click="MenuElement_Click" Tag="Rectangle" />
                <MenuItem Header="Ellipse" Click="MenuElement_Click" Tag="Ellipse" />
                <Separator Background="#d1d2d3"/>
                <MenuItem Header="EAN-13" Click="MenuElement_Click" Tag="EAN13" />
                <MenuItem Header="EAN-8" Click="MenuElement_Click" Tag="EAN8" />
                <MenuItem Header="UPC-A" Click="MenuElement_Click" Tag="UPC-A" />
                <MenuItem Header="UPC-E" Click="MenuElement_Click" Tag="UPC-E" />
                <MenuItem Header="Code 128" Click="MenuElement_Click" Tag="Code128" />
                <MenuItem Header="Code 39" Click="MenuElement_Click" Tag="Code39" />
                <MenuItem Header="DataMatrix" Click="MenuElement_Click" Tag="DataMatrix" />
                <MenuItem Header="PDF417" Click="MenuElement_Click" Tag="PDF417" />
                <MenuItem Header="Aztec" Click="MenuElement_Click" Tag="Aztec" />
                <MenuItem Header="GS1 DataBar" Click="MenuElement_Click" Tag="GS1DataBar" />
                <MenuItem Header="QR Code" Click="MenuElement_Click" Tag="QRCode" />
            </MenuItem>
            <MenuItem Header="_About" Style="{StaticResource MenuItemStyle}">
                <MenuItem Header="_About TaggJack..." x:Name="AboutMenuItem" Click="About_Click">
                    <MenuItem.Icon>
                        <TextBlock Text="ℹ️" FontSize="14" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>
        
        <Grid Background="#f5f5f5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" /> <!-- Compact Toolbox -->
            <ColumnDefinition Width="*" />   <!-- Canvas -->
            <ColumnDefinition Width="320" /> <!-- Expanded Properties -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Modern Toolbar -->
            <RowDefinition Height="*" />    <!-- Main Content -->
        </Grid.RowDefinitions>

        <!-- Modern Floating Toolbar -->
        <Border Grid.ColumnSpan="3" Grid.Row="0" Background="{StaticResource PanelGradient}" 
                BorderBrush="#d1d2d3" BorderThickness="0,0,0,1" Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <!-- Layer Controls -->
                <Border Background="#f8f9fa" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="6" 
                        Padding="12,8" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Layers" Width="18" Height="18" 
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Layers" VerticalAlignment="Center" Margin="0,0,12,0" 
                                  FontWeight="SemiBold" Foreground="#323130" FontSize="12"/>
                        <StackPanel x:Name="LayerControlsContainer" Orientation="Horizontal">
                            <!-- Dynamic layer controls -->
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Zoom Controls -->
                <Border Background="#f8f9fa" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="6" 
                        Padding="12,8" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Magnify" Width="18" Height="18" 
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="0,0,12,0" 
                                  FontWeight="SemiBold" Foreground="#323130" FontSize="12"/>
                        <Button x:Name="ZoomOutButton" Content="−" Width="36" Height="28" Margin="0,0,4,0" 
                               Style="{StaticResource ModernButtonStyle}" ToolTip="Zoom Out" FontSize="14"
                               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Border Background="White" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="3" 
                               Width="60" Height="28" Margin="4,0">
                            <TextBlock x:Name="ZoomTextBlock" Text="100%" VerticalAlignment="Center" 
                                      TextAlignment="Center" FontWeight="SemiBold" Foreground="#323130"/>
                        </Border>
                        <Button x:Name="ZoomInButton" Content="+" Width="36" Height="28" Margin="4,0,8,0" 
                               Style="{StaticResource ModernButtonStyle}" ToolTip="Zoom In" FontSize="14"
                               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button x:Name="ZoomFitButton" Content="⊞" Width="40" Height="28" Margin="0,0,4,0" 
                               Style="{StaticResource ModernButtonStyle}" ToolTip="Fit to Window" FontSize="12"
                               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                        <Button x:Name="ZoomResetButton" Content="1:1" Width="40" Height="28" 
                               Style="{StaticResource ModernButtonStyle}" ToolTip="Reset Zoom" FontSize="11"
                               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Text Alignment Controls -->
                <Border Background="#f8f9fa" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="6" 
                        Padding="12,8" x:Name="AlignmentToolbar">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="FormatAlignJustify" Width="18" Height="18" 
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Align" VerticalAlignment="Center" Margin="0,0,12,0" 
                                  FontWeight="SemiBold" Foreground="#323130" FontSize="12"/>
                        
                        <!-- Horizontal Alignment -->
                        <Button x:Name="AlignLeftButton" Width="40" Height="28" Margin="0,0,2,0"
                               Style="{StaticResource ModernButtonStyle}" ToolTip="Align Left"
                               Click="AlignLeft_Click">
                            <materialIcons:MaterialIcon Kind="FormatAlignLeft" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="AlignCenterButton" Width="40" Height="28" Margin="0,0,2,0"
                               Style="{StaticResource ModernButtonStyle}" ToolTip="Align Center"
                               Click="AlignCenter_Click">
                            <materialIcons:MaterialIcon Kind="FormatAlignCenter" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="AlignRightButton" Width="40" Height="28" Margin="0,0,8,0"
                               Style="{StaticResource ModernButtonStyle}" ToolTip="Align Right"
                               Click="AlignRight_Click">
                            <materialIcons:MaterialIcon Kind="FormatAlignRight" Width="16" Height="16"/>
                        </Button>
                        
                        <!-- Vertical Alignment -->
                        <Button x:Name="AlignTopButton" Width="40" Height="28" Margin="0,0,2,0"
                               Style="{StaticResource ModernButtonStyle}" ToolTip="Align Top"
                               Click="AlignTop_Click">
                            <materialIcons:MaterialIcon Kind="FormatAlignTop" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="AlignMiddleButton" Width="40" Height="28" Margin="0,0,2,0"
                               Style="{StaticResource ModernButtonStyle}" ToolTip="Align Middle"
                               Click="AlignMiddle_Click">
                            <materialIcons:MaterialIcon Kind="FormatAlignMiddle" Width="16" Height="16"/>
                        </Button>
                        <Button x:Name="AlignBottomButton" Width="40" Height="28"
                               Style="{StaticResource ModernButtonStyle}" ToolTip="Align Bottom"
                               Click="AlignBottom_Click">
                            <materialIcons:MaterialIcon Kind="FormatAlignBottom" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Border>
                
                <!-- Data Controls -->
                <Border Background="#f8f9fa" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="6" 
                        Padding="12,8" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Database" Width="18" Height="18" 
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Data" VerticalAlignment="Center" Margin="0,0,12,0" 
                                  FontWeight="SemiBold" Foreground="#323130" FontSize="12"/>
                        <Button x:Name="RefreshDataButton" Content="⟳ Refresh" Height="28" 
                               Style="{StaticResource CompactButtonStyle}" Click="RefreshData_Click"
                               ToolTip="Refresh data from configured source"/>
                        <Border Background="#2D2D30" BorderBrush="#555555" BorderThickness="1" CornerRadius="3" 
                               Padding="8,4" Margin="8,0,0,0">
                            <TextBlock x:Name="DataStatusTextBlock" Text="No data" VerticalAlignment="Center" 
                                      FontStyle="Italic" Foreground="#9CDCFE" FontSize="10"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Modern Toolbox -->
        <Border Grid.Column="0" Grid.Row="1" Background="{StaticResource ToolboxGradient}" 
                BorderBrush="#d1d2d3" BorderThickness="0,0,1,0">
            <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Toolbox" Style="{StaticResource SectionHeaderStyle}" 
                              FontSize="16" Margin="0,0,0,16"/>
                    
                    <Button Content="Text" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="Add text element with customizable fonts and styles"/>
                    <Button Content="Image" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="Add image element (PNG, JPEG, BMP supported)"/>
                    <Button Content="Linked Image" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="Add linked image from URL (loads from web or database)"/>
                    
                    <!-- Drawing Tools -->
                    <TextBlock Text="Drawing" Style="{StaticResource SectionHeaderStyle}" 
                              FontSize="12" Margin="0,16,0,8"/>
                    <Button Content="Line" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="Draw lines with customizable width and color"/>
                    <Button Content="Rectangle" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="Draw rectangles with customizable border width and color"/>
                    <Button Content="Ellipse" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="Draw ovals and circles with customizable border width and color"/>
                    
                    <!-- Barcodes -->
                    <TextBlock Text="Barcodes" Style="{StaticResource SectionHeaderStyle}" 
                              FontSize="12" Margin="0,16,0,8"/>
                    <Button Content="EAN-13" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="European Article Number (13-digit) - Most common retail barcode"/>
                    <Button Content="EAN-8" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="European Article Number (8-digit) - Compact retail barcode"/>
                    <Button Content="UPC-A" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="Universal Product Code A - North American standard"/>
                    <Button Content="UPC-E" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="Universal Product Code E - Compact UPC format"/>
                    <Button Content="Code 128" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="High-density barcode for shipping and logistics"/>
                    <Button Content="Code 39" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="Alphanumeric barcode for inventory management"/>
                    <Button Content="DataMatrix" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="2D barcode for small items and electronics"/>
                    <Button Content="PDF417" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="2D barcode for documents and identification"/>
                    <Button Content="Aztec" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="2D barcode for transportation tickets"/>
                    <Button Content="GS1 DataBar" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="Next-generation GS1 barcode standard"/>
                    <Button Content="QR Code" Style="{StaticResource ToolboxButtonStyle}"
                           ToolTip="QR code for URLs, contact info, and mobile integration"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Modern Canvas Area with Rulers -->
        <Grid Grid.Column="1" Grid.Row="1" Background="#f5f5f5" x:Name="RulerCanvasGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            
            <!-- Modern Horizontal Ruler -->
            <Canvas Grid.Column="1" Grid.Row="0" x:Name="TopRuler" Background="#e1e2e4" 
                   ClipToBounds="True" Height="30">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="TopRulerScaleTransform" ScaleX="1" ScaleY="1" />
                </Canvas.RenderTransform>
                <Canvas.RenderTransformOrigin>0.5,0</Canvas.RenderTransformOrigin>
                <!-- Ruler markings rendered programmatically -->
            </Canvas>
            
            <!-- Modern Vertical Ruler -->
            <Canvas Grid.Column="0" Grid.Row="1" x:Name="LeftRuler" Background="#e1e2e4" 
                   ClipToBounds="True" Width="30">
                <Canvas.RenderTransform>
                    <ScaleTransform x:Name="LeftRulerScaleTransform" ScaleX="1" ScaleY="1" />
                </Canvas.RenderTransform>
                <Canvas.RenderTransformOrigin>0,0.5</Canvas.RenderTransformOrigin>
                <!-- Ruler markings rendered programmatically -->
            </Canvas>
            
            <!-- Modern Corner -->
            <Rectangle Grid.Column="0" Grid.Row="0" Fill="#d1d2d3" />
            
            <!-- Guide Lines Overlay Canvas (spans entire grid) -->
            <Canvas x:Name="GuideLineOverlay" Grid.ColumnSpan="2" Grid.RowSpan="2" 
                   IsHitTestVisible="False" Panel.ZIndex="1000" />
            
            <!-- Modern Canvas Container -->
            <Border Grid.Column="1" Grid.Row="1" Background="White" 
                   BorderBrush="#0078d4" BorderThickness="2" CornerRadius="6" Margin="4">
                <Border.Effect>
                    <DropShadowEffect Color="Gray" BlurRadius="15" ShadowDepth="3" Opacity="0.2"/>
                </Border.Effect>
                <ScrollViewer x:Name="CanvasScrollViewer" 
                             HorizontalScrollBarVisibility="Auto" 
                             VerticalScrollBarVisibility="Auto"
                             CanContentScroll="True"
                             Background="#252526">
                    <Grid x:Name="CanvasContainer" MouseLeftButtonDown="CanvasContainer_MouseLeftButtonDown">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="CanvasScaleTransform" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>
                        
                        <!-- Background Grid with modern styling -->
                        <Canvas x:Name="GridCanvas" Background="#FAFAFA" 
                               MouseLeftButtonDown="CanvasContainer_MouseLeftButtonDown">
                            <Canvas.Effect>
                                <DropShadowEffect Color="#0078d4" BlurRadius="8" ShadowDepth="0" Opacity="0.2"/>
                            </Canvas.Effect>
                        </Canvas>
                        
                        <!-- Main Label Canvas -->
                        <Canvas x:Name="LabelCanvas" Background="Transparent" AllowDrop="True" ClipToBounds="False" 
                                Focusable="True" />
                        
                        <!-- Margin Guidelines -->
                        <Canvas x:Name="MarginCanvas" Background="Transparent" IsHitTestVisible="False" />
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Modern Properties Panel -->
        <Border Grid.Column="2" Grid.Row="1" Background="{StaticResource PanelGradient}" 
                BorderBrush="#d1d2d3" BorderThickness="1,0,0,0">
            <ScrollViewer Margin="16" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Template Properties Section -->
                    <TextBlock Text="🏷️ Label Setup" Style="{StaticResource SectionHeaderStyle}" FontSize="16"/>
                    
                    <!-- Label Size Display -->
                    <TextBlock Text="Label Dimensions" Style="{StaticResource SubHeaderStyle}"/>
                    <Border Background="#f8f9fa" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="📐 Width:" Margin="0,0,8,0" Foreground="#605e5c" FontSize="11"/>
                                <TextBlock x:Name="LabelWidthDisplay" Text="70.0 mm" FontWeight="SemiBold" Foreground="#323130" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📏 Height:" Margin="0,0,8,0" Foreground="#605e5c" FontSize="11"/>
                                <TextBlock x:Name="LabelHeightDisplay" Text="30.0 mm" FontWeight="SemiBold" Foreground="#323130" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <Button x:Name="ResizeButton" Content="📏 Resize Label" Style="{StaticResource ModernButtonStyle}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,16" Click="ResizeButton_Click" 
                            ToolTip="Change label dimensions and adjust elements"/>
                   
                    
                    <!-- Element Properties Section -->
                    <TextBlock Text="🎨 Element Properties" Style="{StaticResource SectionHeaderStyle}" FontSize="16"/>
                    <Border Background="#f8f9fa" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="4" Padding="12" MinHeight="200">
                        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ElementPropertiesPanel">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
                                    <TextBlock Text="🎯" FontSize="24" Margin="0,0,8,0"/>
                                    <TextBlock Text="Select an element to view properties" 
                                              Foreground="#605e5c" FontStyle="Italic" FontSize="11"
                                              TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</DockPanel>
</Window>
