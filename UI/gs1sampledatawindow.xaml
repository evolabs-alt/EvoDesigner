<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="TaggJack.UI.Gs1SampleDataWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TaggJack - GS1 Sample Data" Height="600" Width="1000" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False" xmlns:ui="clr-namespace:TaggJack.UI">
  <Window.Resources>
    <ResourceDictionary>
      <Style x:Key="ModernDataGridStyle" TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="#FFFFFFFF" />
        <Setter Property="BorderBrush" Value="#d1d2d3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="DataGrid.GridLinesVisibility" Value="All" />
        <Setter Property="DataGrid.HorizontalGridLinesBrush" Value="#f3f2f1" />
        <Setter Property="DataGrid.VerticalGridLinesBrush" Value="#f3f2f1" />
        <Setter Property="DataGrid.AutoGenerateColumns" Value="True" />
        <Setter Property="DataGrid.IsReadOnly" Value="True" />
        <Setter Property="DataGrid.SelectionMode" Value="Single" />
        <Setter Property="DataGrid.HeadersVisibility" Value="Column" />
        <Setter Property="DataGrid.CanUserResizeRows" Value="False" />
        <Setter Property="DataGrid.CanUserAddRows" Value="False" />
        <Setter Property="DataGrid.AlternatingRowBackground" Value="#faf9f8" />
        <Setter Property="DataGrid.RowHeight" Value="32" />
      </Style>
      <Style x:Key="{x:Type DataGridColumnHeader}" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="#0078d4" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderBrush" Value="#005a9e" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
      </Style>
      <Style x:Key="{x:Type DataGridCell}" TargetType="{x:Type DataGridCell}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
          <Trigger Property="DataGridCell.IsSelected" Value="True">
            <Setter Property="Background" Value="#e1f5fe" />
            <Setter Property="Foreground" Value="#323130" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#f3f2f1" BorderBrush="#d1d2d3" BorderThickness="0,0,0,1" Padding="20,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="GS1 Sample Data" FontSize="20" FontWeight="SemiBold" Foreground="#323130" />
          <TextBlock x:Name="SubtitleText" Text="Load GS1-shaped rows for field mapping and print preview" FontSize="12" Foreground="#605e5c" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <TextBlock Text="Level:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#323130" />
          <ComboBox x:Name="LevelComboBox" Width="120" Height="32" SelectionChanged="LevelComboBox_SelectionChanged">
            <ComboBoxItem Content="Level 1" Tag="1" IsSelected="True" />
            <ComboBoxItem Content="Level 2" Tag="2" />
            <ComboBoxItem Content="Level 3" Tag="3" />
          </ComboBox>
        </StackPanel>
        <Button x:Name="RefreshButton" Grid.Column="2" Content="↻ Refresh" Width="100" Height="32" Background="#0078d4" Foreground="#FFFFFFFF" BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Click="RefreshButton_Click" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#FFFFFFFF" Padding="20">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <DataGrid x:Name="SampleDataGrid" Style="{StaticResource ModernDataGridStyle}" />
      </ScrollViewer>
    </Border>
    <Border Grid.Row="2" Background="#f3f2f1" BorderBrush="#d1d2d3" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid>
        <TextBlock x:Name="StatusText" Text="No data available" FontSize="11" Foreground="#605e5c" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Use for Mapping" Width="130" Height="32" Margin="0,0,8,0" Background="#0078d4" Foreground="#FFFFFFFF" BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="SemiBold" Click="UseForMappingButton_Click" />
          <Button Content="Close" Width="80" Height="32" Background="#f3f2f1" Foreground="#323130" BorderBrush="#d1d2d3" BorderThickness="1" Cursor="Hand" FontSize="12" Click="CloseButton_Click" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>