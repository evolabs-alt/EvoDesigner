<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="TaggJack.UI.InkjetTemplatePanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#f5f5f5" xmlns:ui="clr-namespace:TaggJack.UI">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock x:Name="TitleText" Text="Markem-Imaje Template" FontSize="22" FontWeight="SemiBold" Foreground="#323130" Margin="0,0,0,4" />
      <TextBlock x:Name="SubtitleText" Text="Map data-source fields to printer external variable positions. Schedule runs enqueue all query rows via queue load." TextWrapping="Wrap" Foreground="#605e5c" FontSize="12" Margin="0,0,0,20" />
      <Border Background="#FFFFFFFF" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="120" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="Printer IP" VerticalAlignment="Center" Foreground="#605e5c" Margin="0,0,0,8" />
          <TextBox x:Name="PrinterHostBox" Grid.Column="1" Height="28" Margin="0,0,12,8" TextChanged="ConfigField_Changed" />
          <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center" Foreground="#605e5c" Margin="0,0,8,8" />
          <TextBox x:Name="PrinterPortBox" Grid.Column="3" Height="28" Margin="0,0,0,8" TextChanged="ConfigField_Changed" />
          <TextBlock x:Name="JobNameLabel" Grid.Row="1" Text="Job Name" VerticalAlignment="Center" Foreground="#605e5c" Margin="0,0,0,8" />
          <TextBox x:Name="JobNameBox" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,0,12,8" TextChanged="ConfigField_Changed" />
          <TextBlock x:Name="JobIdLabel" Grid.Row="1" Grid.Column="2" Text="Job ID" VerticalAlignment="Center" Foreground="#605e5c" Margin="0,0,8,8" />
          <TextBox x:Name="JobIdBox" Grid.Row="1" Grid.Column="3" Height="28" Margin="0,0,0,8" TextChanged="ConfigField_Changed" />
          <TextBlock Grid.Row="2" Text="Var Width" VerticalAlignment="Center" Foreground="#605e5c" />
          <TextBox x:Name="VarWidthBox" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,0,12,0" ToolTip="Pad/truncate variable text (default 10; use 0 for URLs)" TextChanged="ConfigField_Changed" />
        </Grid>
      </Border>
      <Border Background="#FFFFFFFF" BorderBrush="#d1d2d3" BorderThickness="1" CornerRadius="6" Padding="16">
        <DockPanel>
          <DockPanel Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Position Mapping" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Add Row" Width="90" Height="28" Margin="0,0,8,0" Background="#0078d4" Foreground="#FFFFFFFF" BorderThickness="0" Click="AddRow_Click" />
              <Button Content="Delete Selected" Width="120" Height="28" Background="#f3f2f1" BorderBrush="#d1d2d3" BorderThickness="1" Click="DeleteRow_Click" />
            </StackPanel>
          </DockPanel>
          <DataGrid x:Name="MappingsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single" MinHeight="200" MaxHeight="420" BorderBrush="#d1d2d3" BorderThickness="1" CellEditEnding="MappingsGrid_CellEditEnding">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Position" Width="80" IsReadOnly="True" Binding="{Binding Position}" />
              <DataGridTextColumn x:Name="PrinterFieldColumn" Header="Printer Field Name" Width="160" Visibility="Collapsed" Binding="{Binding PrinterFieldName, UpdateSourceTrigger=PropertyChanged}" />
              <DataGridComboBoxColumn Header="Mapping (Data Field)" Width="*" x:Name="FieldComboColumn" SelectedItemBinding="{Binding FieldName, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
        <Button x:Name="RunInkjetButton" Content="Run Now (Queue Load)" Height="32" Padding="16,0" Background="#107c10" Foreground="#FFFFFFFF" BorderThickness="0" FontWeight="SemiBold" Click="RunInkjet_Click" />
        <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#605e5c" FontSize="12" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>